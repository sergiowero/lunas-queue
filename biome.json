{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!spikes", "!**/dist", "!**/*.md", "!pnpm-lock.yaml", "!packages/db/drizzle"]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/schemas/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@lunasq/*"],
                    "message": "Boundary: schemas can only import external packages (docs/tech-stack.md)."
                  },
                  {
                    "group": [
                      "node:*",
                      "fs",
                      "fs/*",
                      "child_process",
                      "net",
                      "http",
                      "better-sqlite3",
                      "drizzle-orm",
                      "drizzle-orm/*",
                      "hono",
                      "hono/*",
                      "@hono/*",
                      "@modelcontextprotocol/*"
                    ],
                    "message": "Boundary: schemas is pure TypeScript; it knows nothing about databases, HTTP, processes or herdr."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/schemas/src/**", "!packages/schemas/**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "process": "Boundary: schemas is pure TypeScript; it knows nothing about the process or the system.",
                  "Buffer": "Boundary: schemas is pure TypeScript; use standard APIs.",
                  "require": "Boundary: schemas is pure TypeScript; use import.",
                  "global": "Boundary: schemas is pure TypeScript; use standard APIs.",
                  "__dirname": "Boundary: schemas is pure TypeScript; use standard APIs.",
                  "__filename": "Boundary: schemas is pure TypeScript; use standard APIs.",
                  "setImmediate": "Boundary: schemas is pure TypeScript; use standard APIs."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/schemas/**/*.test.ts", "packages/schemas/scripts/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@lunasq/*"],
                    "message": "Boundary: schemas can only import external packages (docs/tech-stack.md)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@lunasq/*", "!@lunasq/schemas", "!@lunasq/schemas/**"],
                    "message": "Boundary: domain can only import @lunasq/schemas (docs/tech-stack.md)."
                  },
                  {
                    "group": [
                      "node:*",
                      "fs",
                      "fs/*",
                      "child_process",
                      "net",
                      "http",
                      "better-sqlite3",
                      "drizzle-orm",
                      "drizzle-orm/*",
                      "hono",
                      "hono/*",
                      "@hono/*",
                      "@modelcontextprotocol/*"
                    ],
                    "message": "Boundary: domain is pure TypeScript; it knows nothing about databases, HTTP, processes or herdr."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/db/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@lunasq/*",
                      "!@lunasq/schemas",
                      "!@lunasq/domain",
                      "!@lunasq/schemas/**",
                      "!@lunasq/domain/**"
                    ],
                    "message": "Boundary: db can only import @lunasq/schemas, @lunasq/domain (docs/tech-stack.md)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/adapters/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@lunasq/*", "!@lunasq/schemas", "!@lunasq/schemas/**"],
                    "message": "Boundary: adapters can only import @lunasq/schemas (docs/tech-stack.md)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/server/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@lunasq/*",
                      "!@lunasq/domain",
                      "!@lunasq/db",
                      "!@lunasq/adapters",
                      "!@lunasq/schemas",
                      "!@lunasq/domain/**",
                      "!@lunasq/db/**",
                      "!@lunasq/adapters/**",
                      "!@lunasq/schemas/**"
                    ],
                    "message": "Boundary: server can only import @lunasq/domain, @lunasq/db, @lunasq/adapters, @lunasq/schemas (docs/tech-stack.md)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@lunasq/*", "!@lunasq/schemas", "!@lunasq/schemas/**"],
                    "message": "Boundary: web can only import @lunasq/schemas (docs/tech-stack.md)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/cli/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@lunasq/*", "!@lunasq/server", "!@lunasq/server/**"],
                    "message": "Boundary: cli can only import @lunasq/server (docs/tech-stack.md)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/e2e/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@lunasq/*",
                      "!@lunasq/server",
                      "!@lunasq/adapters",
                      "!@lunasq/schemas",
                      "!@lunasq/server/**",
                      "!@lunasq/adapters/**",
                      "!@lunasq/schemas/**"
                    ],
                    "message": "Boundary: e2e can only import @lunasq/server, @lunasq/adapters, @lunasq/schemas (docs/tech-stack.md)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
