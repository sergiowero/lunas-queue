            "additionalProperties": false
          }
        },
        "knownRisks": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "phase": {
          "type": "string",
          "const": "refinement"
        },
        "body": {
          "type": "object",
          "properties": {
            "domainModel": {
              "type": "object",
              "properties": {
                "boundedContext": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "glossary": {
                  "minItems": 1,
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "term": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      "definition": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      }
                    },
                    "required": ["term", "definition"],
                    "additionalProperties": false
                  }
                },
                "aggregates": {
                  "minItems": 1,
                  "maxItems": 50,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      "entities": {
                        "maxItems": 50,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        }
                      }
                    },
                    "required": ["name", "entities"],
                    "additionalProperties": false
                  }
                },
                "invariants": {
                  "maxItems": 50,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "events": {
                  "maxItems": 50,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      }
                    },
                    "required": ["name", "description"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["boundedContext", "glossary", "aggregates", "invariants", "events"],
              "additionalProperties": false
            },
            "requirements": {
              "minItems": 1,
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "criteria": {
              "minItems": 1,
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^AC-[1-9]\\d*$"
                  },
                  "given": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "when": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "outcome": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "required": ["id", "given", "when", "outcome"],
                "additionalProperties": false
              }
            },
            "taskList": {
              "minItems": 1,
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^T-[1-9]\\d*$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "criterionIds": {
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^AC-[1-9]\\d*$"
                    }
                  }
                },
                "required": ["id", "title", "criterionIds"],
                "additionalProperties": false
              }
            },
            "assumptions": {
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          },
          "required": ["domainModel", "requirements", "criteria", "taskList", "assumptions"],
          "additionalProperties": false
