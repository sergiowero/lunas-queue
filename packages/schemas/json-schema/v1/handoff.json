          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "relevantFiles": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "decisions": {
          "maxItems": 50,
