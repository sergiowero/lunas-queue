{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lunasq:handoff:v1:verification",
  "description": "Handoff v1 de LunasQ, generado desde @lunasq/schemas. Las reglas entre campos (ids únicos, veredicto coherente, tamaño máximo de 32768 bytes) las aplica el validador Zod.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "taskId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "result": {
      "type": "string",
      "enum": ["completed", "partial"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "relevantFiles": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "decisions": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "discarded": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        },
        "required": ["decision"],
        "additionalProperties": false
      }
    },
    "knownRisks": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "phase": {
      "type": "string",
      "const": "verification"
    },
    "body": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["pass", "reject"]
        },
        "criteriaVerdicts": {
          "minItems": 1,
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "criterionId": {
                "type": "string",
                "pattern": "^AC-[1-9]\\d*$"
              },
              "verdict": {
                "type": "string",
                "enum": ["pass", "fail"]
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": ["criterionId", "verdict", "evidence"],
            "additionalProperties": false
          }
        },
        "reviewers": {
          "type": "object",
          "properties": {
            "lunasq-security-reviewer": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ran"
                    },
                    "findings": {
                      "maxItems": 100,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "severity": {
                            "type": "string",
                            "enum": ["critical", "major", "minor"]
                          },
                          "file": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 300
                          },
                          "line": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          "evidence": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2000
                          },
                          "criterionId": {
                            "type": "string",
                            "pattern": "^AC-[1-9]\\d*$"
                          }
                        },
                        "required": ["severity", "file", "evidence"],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": ["status", "findings"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "skipped"
                    },
                    "justification": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  },
                  "required": ["status", "justification"],
                  "additionalProperties": false
                }
              ]
            },
            "lunasq-ux-reviewer": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ran"
                    },
                    "findings": {
                      "maxItems": 100,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "severity": {
                            "type": "string",
                            "enum": ["critical", "major", "minor"]
                          },
                          "file": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 300
                          },
                          "line": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          "evidence": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2000
                          },
                          "criterionId": {
                            "type": "string",
                            "pattern": "^AC-[1-9]\\d*$"
                          }
                        },
                        "required": ["severity", "file", "evidence"],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": ["status", "findings"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "skipped"
                    },
                    "justification": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  },
                  "required": ["status", "justification"],
                  "additionalProperties": false
                }
              ]
            },
            "lunasq-ui-reviewer": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ran"
                    },
                    "findings": {
                      "maxItems": 100,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "severity": {
                            "type": "string",
                            "enum": ["critical", "major", "minor"]
                          },
                          "file": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 300
                          },
                          "line": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          "evidence": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2000
                          },
                          "criterionId": {
                            "type": "string",
                            "pattern": "^AC-[1-9]\\d*$"
                          }
                        },
                        "required": ["severity", "file", "evidence"],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": ["status", "findings"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "skipped"
                    },
                    "justification": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  },
                  "required": ["status", "justification"],
                  "additionalProperties": false
                }
              ]
            },
            "lunasq-code-reviewer": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ran"
                    },
                    "findings": {
                      "maxItems": 100,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "severity": {
                            "type": "string",
                            "enum": ["critical", "major", "minor"]
                          },
                          "file": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 300
                          },
                          "line": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          "evidence": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2000
                          },
                          "criterionId": {
                            "type": "string",
                            "pattern": "^AC-[1-9]\\d*$"
                          }
                        },
                        "required": ["severity", "file", "evidence"],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": ["status", "findings"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "skipped"
                    },
                    "justification": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  },
                  "required": ["status", "justification"],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "lunasq-security-reviewer",
            "lunasq-ux-reviewer",
            "lunasq-ui-reviewer",
            "lunasq-code-reviewer"
          ],
          "additionalProperties": false
        },
        "mustFix": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {
                "type": "string",
                "enum": ["critical", "major", "minor"]
              },
              "file": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "line": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "criterionId": {
                "type": "string",
                "pattern": "^AC-[1-9]\\d*$"
              },
              "source": {
                "type": "string",
                "enum": [
                  "lunasq-security-reviewer",
                  "lunasq-ux-reviewer",
                  "lunasq-ui-reviewer",
                  "lunasq-code-reviewer",
                  "approver"
                ]
              }
            },
            "required": ["severity", "file", "evidence", "source"],
            "additionalProperties": false
          }
        },
        "refuted": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "finding": {
                "type": "object",
                "properties": {
                  "severity": {
                    "type": "string",
                    "enum": ["critical", "major", "minor"]
                  },
                  "file": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "line": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "criterionId": {
                    "type": "string",
                    "pattern": "^AC-[1-9]\\d*$"
                  }
                },
                "required": ["severity", "file", "evidence"],
                "additionalProperties": false
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "source": {
                "type": "string",
                "enum": [
                  "lunasq-security-reviewer",
                  "lunasq-ux-reviewer",
                  "lunasq-ui-reviewer",
                  "lunasq-code-reviewer",
                  "approver"
                ]
              }
            },
            "required": ["finding", "reason", "source"],
            "additionalProperties": false
          }
        },
        "riskLabel": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        }
      },
      "required": ["verdict", "criteriaVerdicts", "reviewers", "mustFix", "refuted", "riskLabel"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "taskId",
    "runId",
    "result",
    "summary",
    "relevantFiles",
    "decisions",
    "knownRisks",
    "phase",
    "body"
  ],
  "additionalProperties": false
}
